"PulseGirlsFrontline"                                                       // Models only; requires ps_3_0.
{
	$basetexture "models/your_model/base_color"                                // sRGB base color; alpha can drive cutout or blending.
	$frame "0"                                                                 // Animation frame for $basetexture.
	$basetexturetransform "center .5 .5 scale 1 1 rotate 0 translate 0 0"      // Base texture UV transform.

	$color "[1 1 1]"                                                           // Primary material color multiplier.
	$color2 "[1 1 1]"                                                          // Additional material color multiplier.
	$srgbtint "[1 1 1]"                                                        // Additional tint when sRGB-correct blending is active.
	$alpha "1"                                                                 // Material opacity; values below 1 use blending.

	$alphatest "0"                                                             // Uses base texture alpha as a cutout when enabled.
	$alphatestreference "0.5"                                                  // Cutout threshold; requires $alphatest 1.
	$translucent "0"                                                           // Enables standard alpha blending and disables the outline.
	$additive "0"                                                              // Enables additive blending and disables the outline.
	$nocull "0"                                                                // Draws both sides when enabled.
	$renderbackface "0"                                                        // Draws backfaces with reversed shading normals; $nocull wins.
	$halflambert "0"                                                           // Uses half-Lambert diffuse falloff when enabled.

	$envmap "env_cubemap"                                                      // Cubemap reflection; defaults to env_cubemap when omitted.
	$mraotexture "models/your_model/mrao"                                      // Linear map: R metalness, G roughness, B ambient occlusion.
	$metalness "0"                                                             // Flat fallback; used only when $mraotexture is absent.
	$roughness "1"                                                             // Flat fallback; used only when $mraotexture is absent.
	$ambientocclusion "1"                                                      // Flat fallback; used only when $mraotexture is absent.
	$specularior "1.5"                                                         // Dielectric index of refraction; 1.5 gives about 0.04 F0.
	$specularweight "1"                                                        // Scales dielectric specular reflectance.
	$speculartint "[1 1 1]"                                                    // Metal reflectance tint at grazing angles.
	$basediffuseroughness "0"                                                  // Diffuse Oren-Nayar roughness; 0 uses Lambert.

	$emissiontexture "models/your_model/emission"                              // sRGB emission color map.
	$bumpmap "models/your_model/normal"                                        // Linear DirectX normal map; defaults to dev/flat_normal.
	$speculartexture "models/your_model/specular_f0"                           // sRGB RGB specular F0 map.

	$detail "models/your_model/detail"                                         // Detail texture combined with the base color.
	$detailframe "0"                                                           // Animation frame for $detail; requires $detail.
	$detailscale "4"                                                           // Detail UV scale; requires $detail.
	$detailblendmode "0"                                                       // TextureCombine mode; 0 is Mod2X and requires $detail.
	$detailblendfactor "1"                                                     // Detail blend strength; requires $detail.
	$detailtint "[1 1 1]"                                                      // Detail color multiplier; requires $detail.
	$detailtexturetransform "center .5 .5 scale 1 1 rotate 0 translate 0 0"    // Detail UV transform.

	$lightwarptexture "models/your_model/lightwarp"                            // Linear 1D ramp; ignored when $diffuseramptexture exists.

	$outlinewidth "0"                                                          // Outline width in model units; 0 disables the outline pass.
	$outlineangle "0"                                                          // Minimum expansion angle in degrees; 0 disables angle fading.
	$outlinecolor "[0 0 0]"                                                    // Outline color.
	$outlinebaseblend "0"                                                      // Base texture contribution to the outline.

	$stocking "0"                                                              // Enables stocking shading; cannot be combined with $face 1.
	$stockingcentercolor "[0.38 0.30 0.28]"                                    // Stocking color facing the camera; requires $stocking 1.
	$stockingfalloffcolor "[0.06 0.035 0.03]"                                  // Stocking color at grazing angles; requires $stocking 1.
	$stockingfalloffpower "1.5"                                                // Stocking view-angle falloff; requires $stocking 1.

	$diffuseramptexture "models/your_model/diffuse_ramp"                       // Lighting ramp; overrides $lightwarptexture.
	$facemaptexture "models/your_model/face_map"                               // Linear map: R face SDF, GB nose highlight, A face mask.
	$facemaptexturetransform "center .5 .5 scale 1 1 rotate 0 translate 0 0"   // Face map UV transform.
	$facemapsmoothness "0.24"                                                  // Face shadow transition width; requires $face 1.
	$nosespecularstrength "1"                                                  // Nose highlight strength; requires $face 1.
	$faceyaw "270"                                                             // Reference-pose facing away from +X; 270 is -Y, 0 is studiomdl convention.
	$eyelid "0"                                                                // Draws lashes or brows over front hair and disables their outline.
	$eyelidblend "0.5"                                                         // Overlay opacity where hair covers it; requires $eyelid 1.
	$face "0"                                                                  // Enables face-map shading; cannot be combined with $stocking 1.

	$casthairshadow "0"                                                        // Casts this mesh into a separate $face material's stencil receiver.
	$hairshadowoffset "[0 0 -2]"                                               // World-space caster displacement; requires $casthairshadow 1.
	$hairshadowstrength "0.5"                                                  // Face darkening from this caster; requires $casthairshadow 1.
}
