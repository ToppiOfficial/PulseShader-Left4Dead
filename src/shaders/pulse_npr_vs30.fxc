// DYNAMIC: "COMPRESSED_VERTS" "0..1"
// DYNAMIC: "DOWATERFOG"       "0..1"
// DYNAMIC: "SKINNING"         "0..1"
// DYNAMIC: "LIGHTING_PREVIEW" "0..1"
// DYNAMIC: "NUM_LIGHTS"       "0..4"
// STATIC:  "OUTLINE"          "0..1"
// STATIC:  "EYELID"           "0..1"

#include "common_vs_fxc.h"
#include "pulse_outline_vs30.h"

static const bool g_bSkinning = SKINNING ? true : false;
static const float PULSE_EYELID_DEPTH_OFFSET = 4.0;
static const int g_FogType = DOWATERFOG;
const float4 cBaseTexCoordTransform[2] : register(SHADER_SPECIFIC_CONST_0);
const float4 cOutlineParams : register(SHADER_SPECIFIC_CONST_2);
const float4 cDetailTexCoordTransform[2] : register(SHADER_SPECIFIC_CONST_3);
const float4 cViewMatrix[3] : register(SHADER_SPECIFIC_CONST_5);

struct VS_INPUT
{
	float4 vPos                    : POSITION;
	float4 vBoneWeights            : BLENDWEIGHT;
	float4 vBoneIndices            : BLENDINDICES;
	float4 vNormal                 : NORMAL;
	float2 vTexCoord0              : TEXCOORD0;
	float3 vPosFlex                : POSITION1;
	float3 vNormalFlex             : NORMAL1;
};

struct VS_OUTPUT
{
	float4 projPosSetup : POSITION;
	float fog           : FOG;
	float2 texCoord     : TEXCOORD0;
	float4 lightAtten   : TEXCOORD1;
	float3 worldNormal  : TEXCOORD2;
	float3 worldPos     : TEXCOORD3;
	float3 projPos      : TEXCOORD4;
	float2 detailCoord  : TEXCOORD5;
	float3 viewNormal   : TEXCOORD6;
};

VS_OUTPUT main(const VS_INPUT v)
{
	VS_OUTPUT o = (VS_OUTPUT)0;
	float4 position = v.vPos;
	float3 normal;
	DecompressVertex_Normal(v.vNormal, normal);
	position.xyz += v.vPosFlex * cViewProjZ.x;
	normal += v.vNormalFlex * cViewProjZ.x;

	float3 worldPos;
	float3 worldNormal;
	SkinPositionAndNormal(g_bSkinning, position, normal, v.vBoneWeights, v.vBoneIndices,
		worldPos, worldNormal);

#if EYELID
	worldPos += normalize(cEyePos - worldPos) * PULSE_EYELID_DEPTH_OFFSET;
#endif

	float4 projPos = mul(float4(worldPos, 1), cViewProj);
#if OUTLINE
	projPos = PulseApplyOutline(projPos, worldPos, worldNormal, cViewProj, cOutlineParams);
#endif
	o.projPosSetup = projPos;
	o.projPos = projPos.xyz;
	o.fog = CalcFog(worldPos, projPos.xyz, g_FogType);
	o.worldPos = worldPos;
	o.worldNormal = normalize(worldNormal);
	o.viewNormal.x = dot(worldNormal, cViewMatrix[0].xyz);
	o.viewNormal.y = dot(worldNormal, cViewMatrix[1].xyz);
	o.viewNormal.z = dot(worldNormal, cViewMatrix[2].xyz);
	o.texCoord.x = dot(v.vTexCoord0, cBaseTexCoordTransform[0]) + cBaseTexCoordTransform[0].w;
	o.texCoord.y = dot(v.vTexCoord0, cBaseTexCoordTransform[1]) + cBaseTexCoordTransform[1].w;
	o.detailCoord.x = dot(v.vTexCoord0, cDetailTexCoordTransform[0]) + cDetailTexCoordTransform[0].w;
	o.detailCoord.y = dot(v.vTexCoord0, cDetailTexCoordTransform[1]) + cDetailTexCoordTransform[1].w;

#if (NUM_LIGHTS > 0)
	o.lightAtten.x = GetVertexAttenForLight(worldPos, 0, false);
#endif
#if (NUM_LIGHTS > 1)
	o.lightAtten.y = GetVertexAttenForLight(worldPos, 1, false);
#endif
#if (NUM_LIGHTS > 2)
	o.lightAtten.z = GetVertexAttenForLight(worldPos, 2, false);
#endif
#if (NUM_LIGHTS > 3)
	o.lightAtten.w = GetVertexAttenForLight(worldPos, 3, false);
#endif

	return o;
}
