# Local working notes - session state, findings in progress. Kept out of the
# repo deliberately; README.md and NOTICE carry what a reader actually needs.
docs/

# Local workflow helpers. They hardcode this machine's Steam path and SDK
# checkout layout, so they are not useful to anyone else; README.md documents
# what they do instead.
install.ps1
uninstall.ps1
scripts/

